#!/bin/sh
# Checks the commit subject is a Conventional Commit before the commit exists (GIT-004, ADR-0027).
# Enable once per clone: git config core.hooksPath .githooks (Initialize-DevMachine -Install offers it).
if ! command -v pwsh >/dev/null 2>&1; then
  echo "commit-msg hook: needs PowerShell 7 (pwsh) on PATH; see https://learn.microsoft.com/powershell/scripting/install/installing-powershell" >&2
  exit 1
fi
exec pwsh -NoProfile -File "$(dirname "$0")/commit-msg.ps1" "$1"
